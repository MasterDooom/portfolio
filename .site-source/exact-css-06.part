ievement-modal { position: relative; display: grid; grid-template-columns: minmax(260px, .85fr) 1.15fr; width: min(900px, 100%); min-height: 500px; background: var(--paper); color: var(--ink); box-shadow: 0 35px 100px rgba(0,0,0,.35); }
.modal-close { position: absolute; z-index: 10; top: 14px; right: 14px; width: 39px; height: 39px; border: 1px solid rgba(20,21,18,.2); background: rgba(238,231,220,.88); display: grid; place-items: center; cursor: pointer; border-radius: 50%; transition: background .2s ease, transform .2s ease; }.modal-close:hover { background: var(--orange); transform: rotate(90deg); }
.achievement-modal__visual { position: relative; min-height: 480px; overflow: hidden; background: #d6c6ae; }.achievement-modal__visual .achievement-art { position: absolute; inset: 0; }.achievement-modal__visual .sasmo-art__number { font-size: 150px; }.achievement-modal__visual .tennis-art .court-art__court { height: 48%; }.achievement-modal__visual .hack-art__window { width: 86%; }.modal-file-tag { position: absolute; left: 20px; bottom: 20px; z-index: 8; color: rgba(20,21,18,.62); font: 8px var(--mono); letter-spacing: .08em; }
.achievement-modal__copy { padding: clamp(28px, 4vw, 50px); display: flex; flex-direction: column; align-items: flex-start; }.modal-category { font: 8px var(--mono); color: #898175; letter-spacing: .08em; margin-top: 34px; }.achievement-modal__copy h2 { font: 500 clamp(32px, 4vw, 48px)/1.04 var(--serif); letter-spacing: -.04em; margin: 10px 0 18px; }.achievement-modal__copy p { color: #656157; font-size: 12px; line-height: 1.8; margin: 0; }.modal-detail { max-width: 430px; }.modal-divider { height: 1px; width: 100%; background: var(--line-paper); margin: 24px 0 17px; }.modal-label { color: #a16039; font: 8px var(--mono); letter-spacing: .08em; margin-bottom: 10px; }.evidence-box { width: 100%; display: flex; gap: 12px; align-items: start; padding: 13px; border: 1px solid rgba(20,21,18,.18); margin-top: 25px; color: #a16039; }.evidence-box > div { display: flex; flex-direction: column; gap: 4px; }.evidence-box strong { font-size: 11px; font-weight: 600; color: var(--ink); }.evidence-box span { font-size: 10px; line-height: 1.6; color: #777166; }.modal-done { display: flex; align-items: center; flex-direction: row-reverse; gap: 9px; border: 0; background: var(--ink); color: var(--paper); padding: 13px 15px; margin-top: auto; cursor: pointer; font-size: 10px; transition: background .2s ease; }.modal-done:hover { background: var(--orange-dark); }

@media (min-width: 1500px) { .hero { padding-left: max(8.2vw, calc((100vw - 1320px)/2)); }.hero-bottom { left: max(8.2vw, calc((100vw - 1320px)/2)); right: max(8.2vw, calc((100vw - 1320px)/2)); } }
@media (max-width: 1100px) {
  .hero { padding-left: 6vw; padding-right: 6vw; }.hero-bottom { left: 6vw; right: 6vw; }.hero-copy { width: 60%; }.hero-art { width: 39%; right: 3%; }.hero-title { font-size: clamp(72px, 9vw, 111px); }.hero-title__line--serif { font-size: clamp(78px, 9.5vw, 120px); margin-left: 3vw; }
  .section-container { width: calc(100% - 12vw); }.feature-spread__grid { gap: 60px; }.timeline-item { grid-template-columns: 70px 130px minmax(220px,1fr) 58px; gap: 20px; }.timeline-list::before { left: 35px; }
}
@media (max-width: 800px) {
  .site-header { height: 70px; padding-inline: 24px; }.desktop-nav, .header-index { display: none; }.mobile-menu-button { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid rgba(245,240,232,.22); background: transparent; color: var(--paper-white); cursor: pointer; }.mobile-nav { display: none; flex-direction: column; position: fixed; z-index: 99; top: 70px; right: 0; left: 0; background: rgba(11,13,15,.97); padding: 12px 24px 23px; border-bottom: 1px solid rgba(245,240,232,.14); backdrop-filter: blur(15px); }.mobile-nav a { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-bottom: 1px solid rgba(245,240,232,.12); color: var(--paper-white); font-size: 14px; }.mobile-nav a:last-child { border: 0; }
  .hero { height: auto; min-height: 930px; max-height: none; display: block; padding: 145px 7vw 75px; }.hero-copy { width: 100%; margin: 0; }.hero-title { font-size: clamp(70px, 12vw, 105px); }.hero-title__line--serif { font-size: clamp(78px, 13vw, 113px); margin-left: 5vw; }.hero-description { margin-top: 22px; max-width: 360px; }.hero-art { top: auto; bottom: 72px; height: 390px; width: min(65%, 440px); right: 8%; }.hero-art__medal { width: 80%; height: 100%; }.hero-art__stamp { width: 80px; height: 80px; left: -5%; bottom: 14%; }.hero-stat-card { width: 153px; right: -7%; bottom: 5%; padding: 13px; }.hero-stat-card__rank { font-size: 53px; }.hero-sticker--top { right: -2%; }.hero-art__coordinates { right: -7%; }.hero-bottom { bottom: 22px; left: 7vw; right: 7vw; }.hero-bottom__right { display: none; }.hero-grid-line--v { left: 70%; }
  .section-container { width: calc(100% - 12vw); }.archive-section, .projects-section, .journey-section, .reflection-section { padding: 95px 0; }.archive-intro__headline { grid-template-columns: 1fr; gap: 25px; }.archive-intro h2, .projects-heading h2 { font-size: clamp(49px, 10vw, 75px); }.archive-intro__aside { max-width: 480px; display: grid; grid-template-columns: 38px 1fr; gap: 0 10px; }.archive-intro__aside p { max-width: 100%; }.archive-intro__aside .small-meta { grid-column: 2; }.aside-mark { grid-row: span 2; }
  .archive-toolbar { align-items: start; }.archive-toolbar__left { gap: 11px; }.archive-count { margin-top: 24px; }.achievement-grid { gap: 28px 14px; }.achievement-card { grid-column: span 6; }.achievement-card__visual { height: clamp(240px, 43vw, 330px); }.achievement-card__meta { flex-direction: column; gap: 5px; }.sasmo-art { padding: 25px; }.sasmo-art__number { font-size: clamp(85px, 15vw, 140px); }
  .feature-spread { padding: 95px 0; }.feature-spread__grid { grid-template-columns: 1fr; gap: 43px; padding-top: 45px; }.feature-spread__left h2 { font-size: clamp(64px, 12vw, 90px); }.feature-spread__right { max-width: 440px; width: 100%; margin: auto; }.feature-card { max-width: 320px; }
  .projects-heading__row { grid-template-columns: 1fr; gap: 23px; margin-bottom: 42px; }.projects-heading__row > p { max-width: 490px; }.project-row { grid-template-columns: minmax(170px, .8fr) 1fr 34px; gap: 22px; }.project-row__art { height: 210px; }.project-row__content h3 { margin-top: 18px; }.project-row__top { flex-direction: column; gap: 5px; }.project-row__arrow { width: 32px; height: 32px; }
  .journey-heading { grid-template-columns: 1fr; gap: 22px; margin-bottom: 52px; }.journey-heading h2 { font-size: clamp(58px, 11vw, 85px); }.journey-heading > div > p { max-width: 480px; }.timeline-item { grid-template-columns: 47px 1fr; gap: 8px 19px; padding: 27px 0; }.timeline-list::before { left: 23px; }.timeline-item__marker { grid-row: span 2; align-self: stretch; }.timeline-item__marker span { width: 31px; height: 31px; }.timeline-item__time { padding-top: 4px; 