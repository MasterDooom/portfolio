r: var(--ink); background: var(--orange); }
.hero-note { font: 8px var(--mono); color: #777970; letter-spacing: .075em; }
.hero-art { position: absolute; width: 39%; height: 76%; right: clamp(10px, 6.4vw, 108px); top: 13%; z-index: 1; max-width: 550px; }
.hero-art__backplate { position: absolute; width: 69%; height: 77%; top: 11%; left: 15%; border: 1px solid rgba(245,240,232,.18); transform: rotate(7deg); background: linear-gradient(145deg, rgba(255,255,255,.045), transparent 45%); }
.hero-art__orbit { position: absolute; width: 88%; aspect-ratio: 1; top: 1%; left: 8%; border: 1px dashed rgba(217,140,86,.23); border-radius: 50%; }
.hero-art__orbit::after { content: ''; position: absolute; width: 7px; height: 7px; top: 12%; right: 15%; border-radius: 50%; background: var(--orange); box-shadow: 0 0 22px rgba(217,140,86,.75); }
.hero-art__medal { position: absolute; width: 88%; height: 97%; top: -3%; left: 0; filter: drop-shadow(0 30px 26px rgba(0,0,0,.32)); }
.medal-art { width: 100%; height: 100%; overflow: visible; }
.hero-art__medal .medal-art { transform: rotate(-6deg); }
.hero-sticker { position: absolute; z-index: 4; background: var(--orange); color: #1a1713; font: 9px var(--mono); letter-spacing: .07em; display: flex; gap: 8px; align-items: center; padding: 9px 11px; }
.hero-sticker--top { top: 8%; right: 1%; transform: rotate(3deg); }
.hero-sticker--top svg { animation: slow-spin 16s linear infinite; }
.hero-stat-card { position: absolute; z-index: 5; right: 0; bottom: 12%; width: 180px; padding: 17px 17px 15px; background: #eee7dc; color: var(--ink); box-shadow: 0 17px 60px rgba(0,0,0,.25); transform: rotate(3deg); }
.hero-stat-card__label, .hero-stat-card__caption { display: block; font: 8px var(--mono); letter-spacing: .055em; }
.hero-stat-card__label { color: #79756a; }
.hero-stat-card__rank { display: block; font: 500 67px/.95 var(--serif); letter-spacing: -.07em; margin-top: 11px; }
.hero-stat-card__rank span { font: italic 22px var(--serif); vertical-align: top; margin-left: 3px; }
.hero-stat-card__caption { margin-top: 8px; }
.hero-stat-card__line { width: 100%; height: 1px; background: #c3bbae; margin-top: 17px; }
.hero-art__stamp { position: absolute; width: 96px; height: 96px; border: 1px solid rgba(217,140,86,.7); border-radius: 50%; display: grid; place-items: center; text-align: center; bottom: 16%; left: -3%; color: var(--orange); font: 8px/1.55 var(--mono); letter-spacing: .1em; }
.hero-art__stamp i { font-style: normal; color: #e3d4bc; }
.hero-art__coordinates { position: absolute; top: 27%; right: -3%; color: #8b8c84; font: 8px/1.7 var(--mono); letter-spacing: .1em; writing-mode: vertical-rl; }
.hero-bottom { position: absolute; left: clamp(24px, 8.2vw, 136px); right: clamp(24px, 8.2vw, 136px); bottom: 31px; z-index: 4; display: flex; align-items: center; gap: 14px; color: #85877e; font: 8px var(--mono); letter-spacing: .1em; }
.scroll-cue { display: grid; place-items: center; color: var(--orange); width: 25px; height: 25px; border: 1px solid rgba(217,140,86,.35); border-radius: 50%; }
.hero-bottom__right { margin-left: auto; }
.hero-bottom__right span { color: var(--orange); margin-left: 9px; }
.ticker { height: 54px; background: var(--orange); color: #211910; overflow: hidden; display: flex; align-items: center; }
.ticker__track { display: flex; align-items: center; width: max-content; animation: ticker 32s linear infinite; }
.ticker__track > span { white-space: nowrap; display: flex; gap: 23px; align-items: center; padding-right: 23px; font: 10px var(--mono); letter-spacing: .13em; }
.ticker__track svg { stroke-width: 1.4; }
@keyframes ticker { to { transform: translateX(-50%); } }
@keyframes slow-spin { to { transform: rotate(360deg); } }

.archive-section { padding: 130px 0 120px; }
.archive-intro { border-bottom: 1px solid var(--line-paper); padding-bottom: 45px; }
.archive-intro__headline { display: grid; grid-template-columns: 1fr minmax(230px, 350px); gap: 50px; align-items: end; margin-top: 34px; }
.archive-intro h2, .projects-heading h2, .journey-heading h2, .closing-container h2 { margin: 0; font: 600 clamp(48px, 6.3vw, 90px)/.99 var(--sans); letter-spacing: -.075em; }
.archive-intro h2 em, .projects-heading h2 em, .journey-heading h2 em, .closing-container h2 em { font: italic 500 1.03em/.95 var(--serif); letter-spacing: -.06em; }
.archive-intro__aside { padding-bottom: 5px; }
.aside-mark { display: block; color: var(--orange-dark); font: 46px/.9 var(--serif); margin-bottom: 16px; }
.archive-intro__aside p { margin: 0 0 22px; font-size: 13px; line-height: 1.8; max-width: 335px; color: #53534c; }
.archive-toolbar { display: flex; justify-content: space-between; align-items: end; padding: 28px 0 25px; }
.archive-toolbar__left { display: flex; flex-direction: column; gap: 14px; }
.filter-group { display: flex; flex-wrap: wrap; gap: 7px; }
.filter-button { cursor: pointer; border: 1px solid rgba(20,21,18,.22); background: transparent; padding: 8px 13px; color: #68665d; font-size: 10px; transition: color .25s ease, background .25s ease, border-color .25s ease; }
.filter-button:hover { border-color: var(--ink); color: var(--ink); }
.filter-button.is-selected { background: var(--ink); border-color: var(--ink); color: var(--paper); }
.archive-count { color: var(--ink); font: 25px var(--serif); }
.archive-count i { font: 8px var(--mono); letter-spacing: .06em; color: #78756e; margin-left: 3px; }
.achievement-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 26px 20px; align-items: start; }
.achievement-card { grid-column: span 6; min-width: 0; }
.achievement-card:nth-child(4n + 1) { grid-column: span 7; }
.achievement-card:nth-child(4n + 2) { grid-column: span 5; }
.achievement-card:nth-child(4n + 3) { grid-column: span 5; }
.achievement-card:nth-child(4n + 4) { grid-column: span 7; }
.achievement-card.is-filtered-out { display: none; }
.achievement-grid.is-filtering .achievement-card { grid-column: 3 / span 8; }
.achievement-card__button { display: block; width: 100%; color: inherit; background: none; text-align: left; border: 0; padding: 0; cursor: pointer; }
.achievement-card__visual { position: relative; width: 100%; height: clamp(260px, 33vw, 430px); overflow: hidden; background: #ded4c4; isolation: isolate; }
.achievement-card__visual::after { content: ''; position: absolute; inset: 0; pointer-events: none; border: 1px solid rgba(20,21,18,.1); }
.achievement-card:nth-child(2) .achievement-card__visual { background: #d7e0d5; }
.achievement-card:nth-child(3) .achievement-card__visual { background: #c6cdd0; }
.achievement-card:nth-child(4) .achievement-card__visual { background: #d8c4a6; }
.card-index { position: absolute; z-index: 5; top: 16px; left: 16px; font: 9px var(--mono); letter-spacing: .07em; color: rgba(20,21,18,.65); }
.card-open { position: absolute; z-index: 6; bottom: 15px; right: 15px; display: grid; place-items: center; width: 39px; height: 39px; background: var(--paper-white); border-radius: 50%; trans