}.timeline-item__body { grid-column: 2; }.timeline-item__body h3 { font-size: 28px; }.timeline-item__hint { display: none; }
  .reflection-quote { margin: 60px 0; font-size: clamp(39px, 8vw, 62px); padding-left: 24px; }.reflection-bottom { grid-template-columns: 1fr; gap: 30px; }.reflection-bottom__lead { max-width: 420px; }.reflection-prompts { gap: 17px; }.reflection-prompts p { font-size: 11px; }
  .closing-section { padding-top: 95px; }.closing-container h2 { font-size: clamp(62px, 12vw, 94px); }.closing-cta { margin-bottom: 75px; }.closing-orbit--one { width: 390px; height: 390px; right: -23%; top: 14%; }.closing-orbit--two { width: 310px; height: 310px; right: -12%; top: 22%; }.closing-signoff { flex-wrap: wrap; }.site-footer { padding-block: 17px; flex-wrap: wrap; justify-content: flex-start; }.site-footer span:nth-child(2) { order: 3; width: 100%; }
  .achievement-modal { grid-template-columns: 1fr; max-width: 540px; }.achievement-modal__visual { min-height: 260px; height: 260px; }.achievement-modal__visual .achievement-art { inset: 0; }.achievement-modal__visual .sasmo-art__number { font-size: 110px; }.achievement-modal__visual .medal-art { width: 65%; left: 17%; }.achievement-modal__copy { padding: 26px; }.modal-category { margin-top: 24px; }.modal-done { margin-top: 28px; }
}
@media (max-width: 520px) {
  .wordmark { min-width: 0; }.wordmark__symbol { width: 32px; height: 32px; }.wordmark__text { font-size: 8px; }
  .hero { min-height: 850px; padding: 128px 6vw 70px; }.hero-eyebrow { flex-wrap: wrap; font-size: 8px; margin-bottom: 34px; }.eyebrow__year { margin-left: auto; }.hero-title { font-size: clamp(53px, 12vw, 76px); letter-spacing: -.09em; }.hero-title__line--serif { font-size: clamp(64px, 14vw, 85px); margin-left: 3vw; }.hero-description { font-size: 12px; max-width: 310px; margin-top: 20px; }.hero-actions { align-items: flex-start; flex-direction: column; gap: 17px; }.hero-note { font-size: 7px; }.hero-art { width: 83%; max-width: 350px; height: 330px; right: 6%; bottom: 67px; }.hero-art__medal { width: 78%; left: -2%; }.hero-art__orbit { width: 86%; left: 4%; }.hero-art__backplate { height: 76%; left: 12%; width: 68%; }.hero-art__stamp { width: 65px; height: 65px; font-size: 7px; left: 0; bottom: 14%; }.hero-stat-card { width: 135px; bottom: 4%; right: -2%; padding: 11px; }.hero-stat-card__rank { font-size: 47px; }.hero-stat-card__label, .hero-stat-card__caption { font-size: 7px; }.hero-sticker--top { top: 4%; font-size: 7px; padding: 7px 8px; }.hero-art__coordinates { display: none; }.hero-bottom { font-size: 7px; }
  .ticker { height: 43px; }.ticker__track > span { font-size: 8px; gap: 16px; padding-right: 16px; }
  .section-container { width: calc(100% - 12vw); }.archive-section, .projects-section, .journey-section, .reflection-section { padding: 78px 0; }.section-label { font-size: 8px; }.archive-intro__headline { margin-top: 27px; }.archive-intro h2, .projects-heading h2 { font-size: clamp(47px, 11.5vw, 60px); }.archive-intro__aside p { font-size: 12px; }.archive-toolbar { gap: 12px; flex-direction: column; }.archive-toolbar__left { width: 100%; }.archive-count { margin-top: 0; align-self: end; font-size: 20px; }.filter-button { padding: 8px 10px; font-size: 9px; }.achievement-grid { grid-template-columns: 1fr; gap: 31px; }.achievement-card, .achievement-card:nth-child(4n + 2), .achievement-card:nth-child(4n + 3) { grid-column: span 1; }.achievement-card__visual { height: 320px; }.achievement-card__meta { flex-direction: row; font-size: 7px; }.achievement-card h3 { font-size: 29px; }.archive-note { grid-template-columns: 36px 1fr; gap: 12px; margin-top: 43px; }.archive-note__icon { width: 34px; height: 34px; }.archive-note p { font-size: 11px; }.archive-note > .small-meta { grid-column: 2; }
  .feature-spread { padding: 80px 0; }.feature-spread__left h2 { font-size: 64px; }.feature-spread__overline { font-size: 8px; }.feature-spread__bottom { grid-template-columns: 24px 1fr; gap: 13px; margin-top: 30px; }.feature-spread__bottom p { font-size: 11px; }.feature-spread__right { padding: 18px 8px; }.feature-card { max-width: 270px; padding: 22px; }.feature-card__number { font-size: 112px; margin-top: 32px; }.feature-card__title { font-size: 41px; }.feature-side-caption { right: -4px; }
  .project-row { grid-template-columns: 1fr 30px; gap: 15px; padding: 20px 0 23px; }.project-row__art { grid-column: 1 / -1; height: 210px; }.project-row__content h3 { font-size: 27px; }.project-row__top { flex-direction: row; }.project-row__content > p { font-size: 11px; }.project-row__arrow { grid-column: 2; grid-row: 2; align-self: start; margin-top: 3px; }.projects-footer { flex-direction: column; gap: 12px; }.projects-footer p { font-size: 11px; }
  .journey-heading h2 { font-size: 62px; }.timeline-item { grid-template-columns: 36px 1fr; gap: 7px 13px; }.timeline-list::before { left: 18px; }.timeline-item__marker span { width: 28px; height: 28px; font-size: 8px; }.timeline-item__time { font-size: 7px; }.timeline-item__body h3 { font-size: 25px; }.timeline-item__body p { font-size: 11px; }.journey-foot { align-items: start; line-height: 1.7; font-size: 7px; }
  .reflection-top { align-items: start; }.reflection-top__note { font-size: 7px; }.reflection-quote { margin: 51px 0; padding-left: 20px; font-size: clamp(37px, 9.4vw, 48px); }.reflection-bottom__lead { font-size: 21px; }.reflection-prompts { grid-template-columns: 1fr; gap: 19px; }.reflection-prompts > div { display: grid; grid-template-columns: 130px 1fr; gap: 13px; }.reflection-prompts p { margin: 0; }
  .closing-section { padding-top: 78px; }.closing-container h2 { font-size: clamp(53px, 12vw, 72px); margin-top: 30px; }.closing-container > div > p { font-size: 12px; }.closing-cta { margin-bottom: 60px; }.closing-signoff { display: grid; grid-template-columns: 1fr 1fr; font-size: 7px; gap: 12px; }.closing-signoff span:last-child { grid-column: 1 / -1; }.site-footer { gap: 12px; font-size: 7px; }.site-footer > span:first-child { width: 100%; }
  .modal-backdrop { padding: 15px; align-items: center; }.achievement-modal { max-height: calc(100svh - 30px); overflow-y: auto; }.achievement-modal__visual { flex: 0 0 215px; height: 215px; min-height: 215px; }.achievement-modal__copy { padding: 24px 22px; }.achievement-modal__copy h2 { font-size: 34px; }.modal-category { margin-top: 21px; }.modal-done { margin-top: 24px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}

 /* Standalone preview helpers. The React build uses Motion for React for these effects. */ 
.js-reveal { opacity: 0; transform: translateY(24px); transition: opacity .78s cubic-bezier(.22,1,.36,1), transform .78s cubic-bezier(.22,1,.36,1); }
.js-reveal.is-visible { opacity: 1; transform: translateY(0); }
.hero-title__line > span { animation: hero-reveal 1.05s cubic-bezier(.22,1,.36,1) both; }
.hero-title__line:nth-child(2) > span { animation-delay: .16s; }
@keyframes hero-reveal { from { transform: translateY(110%); } to { transform: translateY(0); } }
.modal-backdrop { opacity: 0; visibility: hidden; transition: opacity .22s ease, visibility .22s ease; }
.modal-backdrop.is-open { opacity: 1; visibility: visible; }
.modal-backdrop.is-open .achievement-modal { animation: modal-rise .38s cubic-bezier(.22,1,.36,1) both; }
@keyframes modal-rise { from { opacity: 0; transform: translateY(24px) scale(.985); } to { opacity: 1; transform: translateY(0) scale(1); } }
.project-row__art-tag { position: absolute; bottom: 12px; left: 12px; z-index: 5; color: rgba(20,21,18,.56); font: 8px var(--mono); letter-spacing: .07em; }
@media (prefers-reduced-motion: reduce) { .js-reveal { opacity: 1; transform: none; } .hero-title__line > span { animation: none; } .ticker__track { animation: none; } }
