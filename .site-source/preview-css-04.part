
.feature-spread { position: relative; overflow: hidden; padding: 126px 0 135px; background: #101411; isolation: isolate; }
.feature-spread::before { content: ''; position: absolute; inset: 0; z-index: -2; background: radial-gradient(ellipse at 72% 54%, rgba(72,87,67,.25), transparent 45%), linear-gradient(95deg,#0b0d0f,#131713); }
.feature-spread__inner { position: relative; }
.feature-spread__grid { display: grid; grid-template-columns: 1fr minmax(340px, .85fr); gap: clamp(50px, 11vw, 170px); align-items: center; padding-top: 65px; }
.feature-spread__overline { color: #888b81; font: 9px/1.8 var(--mono); letter-spacing: .1em; margin: 0 0 26px; }
.feature-spread__left h2 { color: var(--paper-white); font: 600 clamp(62px, 7.4vw, 108px)/.94 var(--sans); letter-spacing: -.08em; margin: 0; }
.feature-spread__left h2 em { color: var(--orange); font: italic 500 1.02em/.9 var(--serif); }
.feature-spread__bottom { display: grid; grid-template-columns: 33px minmax(150px, 320px); gap: 17px; align-items: start; margin-top: 42px; }
.feature-spread__dash { width: 30px; height: 1px; background: var(--orange); margin-top: 10px; }
.feature-spread__bottom p { font-size: 12px; line-height: 1.85; margin: 0; color: #9d9f96; }
.feature-spread__right { position: relative; padding: 30px 20px; }
.feature-card { position: relative; max-width: 385px; aspect-ratio: .72; margin: auto; padding: 27px; overflow: hidden; background: linear-gradient(150deg, #eee7dc, #d9c9b0); color: #171913; box-shadow: 0 30px 80px rgba(0,0,0,.32); transform: rotate(4deg); transition: transform .55s cubic-bezier(.22,1,.36,1); }
.feature-spread__right:hover .feature-card { transform: rotate(0) translateY(-5px); }
.feature-card__top, .feature-card__bottom { position: relative; z-index: 2; display: flex; justify-content: space-between; gap: 15px; font: 8px var(--mono); letter-spacing: .07em; color: #68645a; }
.feature-card__number { position: relative; z-index: 2; font: 500 clamp(100px, 12vw, 155px)/.9 var(--serif); letter-spacing: -.1em; margin-top: 42px; color: #9c572f; }
.feature-card__number span { font: italic 24px var(--serif); vertical-align: top; margin-left: 9px; }
.feature-card__title { position: relative; z-index: 2; font: 700 clamp(36px, 4vw, 55px)/.9 var(--sans); letter-spacing: -.07em; text-transform: uppercase; }
.feature-card__title em { font: italic 500 1.03em var(--serif); text-transform: none; }
.feature-card__separator { position: relative; z-index: 2; height: 1px; background: rgba(20,21,18,.28); margin: 28px 0 14px; }
.feature-card__bottom { align-items: center; }
.feature-card__seal { width: 40px; height: 40px; display: grid; place-items: center; border: 1px solid rgba(20,21,18,.4); border-radius: 50%; color: #9c572f; }
.feature-card__ghost { position: absolute; right: -25px; bottom: -70px; font: 700 280px/.8 var(--sans); letter-spacing: -.12em; color: rgba(20,21,18,.045); }
.feature-side-caption { position: absolute; right: -18px; bottom: 2px; display: flex; align-items: start; gap: 7px; color: #999b90; font: 8px/1.7 var(--mono); letter-spacing: .07em; }.feature-side-caption svg { color: var(--orange); }

.projects-section { padding: 130px 0 130px; }
.projects-heading__row { display: grid; grid-template-columns: 1fr minmax(220px, 370px); gap: 50px; align-items: end; margin-top: 32px; margin-bottom: 65px; }
.projects-heading h2 { font-size: clamp(50px, 6.3vw, 88px); }
.projects-heading__row > p { max-width: 360px; color: #6c685e; font-size: 13px; line-height: 1.85; margin: 0 0 6px; }
.project-list { border-top: 1px solid var(--line-paper); }
.project-row { position: relative; display: grid; grid-template-columns: minmax(220px, .83fr) 1fr 42px; align-items: center; gap: clamp(25px, 5vw, 74px); border-bottom: 1px solid var(--line-paper); padding: 25px 0; }
.project-row__art { min-width: 0; height: 235px; overflow: hidden; }
.project-art { position: relative; overflow: hidden; width: 100%; height: 100%; display: grid; place-items: center; }
.project-art--build { background: #c9d3cc; }.project-art--team { background: #d6c4ab; }.project-art--ideas { background: #d8d6ca; color: #29352c; align-items: start; align-content: center; padding-left: 14%; }
.project-art__window { position: relative; width: 76%; height: 73%; background: #19231f; box-shadow: 0 15px 30px rgba(25,35,31,.2); transform: rotate(-3deg); transition: transform .45s ease; }
.project-row:hover .project-art__window { transform: rotate(0) translateY(-3px); }
.project-art__chrome { height: 25px; background: #2d3832; display: flex; align-items: center; gap: 4px; padding-left: 10px; }.project-art__chrome span { width: 5px; height: 5px; border-radius: 50%; background: #c67f51; }.project-art__chrome span:nth-child(2) { background: #9caf9d; }.project-art__chrome span:nth-child(3) { background: #888e85; }
.code-block { display: flex; gap: 10px; padding: 8px 11px 0; color: #e1dfd3; font: 9px var(--mono); }.code-block i { color: #77857b; font-style: normal; }.code-block span { color: #d98c56; }.code-block b { color: #a8c5a7; font-weight: 400; }.code-block em { color: #dcbb83; font-style: normal; }
.project-art__cursor { position: absolute; height: 13px; width: 1px; background: #d98c56; left: 79%; top: 60%; animation: cursor-blink 1.2s steps(2) infinite; }
@keyframes cursor-blink { 50% { opacity: 0; } }
.orbit { position: absolute; border: 1px solid rgba(63,64,52,.5); border-radius: 50%; transform: rotate(-30deg); }.orbit--one { width: 90%; height: 52%; }.orbit--two { width: 76%; height: 80%; transform: rotate(43deg); }.orbit--three { width: 48%; height: 93%; transform: rotate(68deg); }
.team-node { position: absolute; width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center; background: #eee7dc; color: #25251f; font: 8px var(--mono); letter-spacing: .07em; border: 1px solid rgba(27,29,24,.2); box-shadow: 0 7px 15px rgba(32,31,24,.1); }.team-node--one { top: 16%; left: 20%; }.team-node--two { top: 19%; right: 17%; background: #c6d0c3; }.team-node--three { bottom: 16%; left: 27%; background: #d98c56; }.team-node--four { bottom: 13%; right: 20%; }.project-art--team > svg { position: absolute; color: #5d6657; }
.project-art--ideas > span { font: 600 clamp(24px, 3vw, 40px)/.94 var(--sans); letter-spacing: -.08em; }.project-art--ideas > span:nth-child(2) { margin-left: 24px; }.project-art--ideas .project-art__italic { font: italic 500 clamp(27px, 3.25vw, 45px)/.95 var(--serif); color: #9e5b35; margin-left: 39px; margin-top: 5px; }.project-art__scribble { position: absolute; height: 1px; width: 60%; background: #9e5b35; left: 19%; bottom: 20%; transform: rotate(-7deg); }.project-art--ideas svg { position: absolute; right: 14%; top: 18%; color: #a46038; }
