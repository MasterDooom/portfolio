
:root {
  font-family: 'DM Sans', sans-serif;
  color: #141512;
  background: #0b0d0f;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  --ink: #0b0d0f;
  --ink-soft: #141715;
  --paper: #eee7dc;
  --paper-white: #f5f0e8;
  --muted-paper: #b6b0a6;
  --orange: #d98c56;
  --orange-dark: #a85f37;
  --green: #476d5b;
  --line-dark: rgba(245, 240, 232, .18);
  --line-paper: rgba(20, 21, 18, .18);
  --mono: 'DM Mono', monospace;
  --serif: 'Playfair Display', Georgia, serif;
  --sans: 'Manrope', 'DM Sans', sans-serif;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 90px; background: var(--ink); }
body { margin: 0; min-width: 320px; background: var(--paper); }
body.modal-open { overflow: hidden; }
button, a { -webkit-tap-highlight-color: transparent; }
button { font: inherit; }
a { color: inherit; text-decoration: none; }
button:focus-visible, a:focus-visible { outline: 2px solid var(--orange); outline-offset: 5px; }
::selection { background: var(--orange); color: var(--ink); }

.site-shell { overflow: clip; width: 100%; }
.read-progress { position: fixed; z-index: 1000; top: 0; left: 0; right: 0; height: 2px; background: var(--orange); transform-origin: 0 50%; }
.site-header { position: fixed; z-index: 100; inset: 0 0 auto; height: 82px; padding: 0 clamp(24px, 5vw, 82px); display: flex; align-items: center; justify-content: space-between; color: var(--paper-white); border-bottom: 1px solid rgba(245,240,232,.11); background: rgba(11,13,15,.76); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }
.wordmark { display: inline-flex; align-items: center; gap: 11px; min-width: 215px; }
.wordmark__symbol { width: 35px; height: 35px; display: inline-grid; place-items: center; border: 1px solid rgba(217,140,86,.65); border-radius: 50%; color: var(--orange); font: 600 23px var(--serif); line-height: 1; }
.wordmark__text { color: #c9c4bb; font: 9px/1.45 var(--mono); letter-spacing: .08em; }
.desktop-nav { display: flex; align-items: center; gap: clamp(20px, 3vw, 45px); }
.desktop-nav a { position: relative; color: #a8aaa4; font-size: 11px; transition: color .25s ease; padding: 11px 0; }
.desktop-nav a span { position: absolute; left: 0; right: 0; bottom: 2px; height: 1px; background: var(--orange); transform: scaleX(0); transform-origin: left; transition: transform .35s cubic-bezier(.2,.7,.2,1); }
.desktop-nav a:hover, .desktop-nav a.is-active { color: var(--paper-white); }
.desktop-nav a.is-active span, .desktop-nav a:hover span { transform: scaleX(1); }
.header-index { display: flex; align-items: center; gap: 8px; color: #b6b4ad; font: 9px var(--mono); letter-spacing: .06em; }
.header-index svg { color: var(--orange); }
.header-index__dot { width: 6px; height: 6px; display: inline-block; border-radius: 50%; background: var(--orange); box-shadow: 0 0 0 4px rgba(217,140,86,.1); }
.mobile-menu-button, .mobile-nav { display: none; }
.mobile-nav.is-open { display: flex; }

.dark-section { background: var(--ink); color: var(--paper-white); }
.paper-section { background: var(--paper); color: var(--ink); }
.section-container { width: min(1320px, calc(100% - clamp(44px, 10vw, 160px))); margin-inline: auto; }
.section-label { display: flex; align-items: center; gap: 11px; color: #6e6c63; font: 10px var(--mono); letter-spacing: .12em; text-transform: uppercase; }
.section-label__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--orange-dark); flex: 0 0 auto; }
.section-label--invert { color: #a9aaa3; }
.section-label--invert .section-label__dot { background: var(--orange); }
.small-meta { font: 9px/1.6 var(--mono); letter-spacing: .08em; color: #868279; }

.hero { min-height: 780px; height: min(100svh, 1000px); max-height: 1020px; position: relative; isolation: isolate; overflow: hidden; padding: 160px clamp(24px, 8.2vw, 136px) 80px; display: flex; align-items: center; }
.hero::before { content: ''; position: absolute; inset: 0; z-index: -3; background: radial-gradient(ellipse at 78% 45%, rgba(93,84,61,.2), transparent 37%), linear-gradient(115deg, #0b0d0f 8%, #0c100f 60%, #121411 100%); }
.hero-grain, .feature-spread__noise { position: absolute; inset: 0; opacity: .13; pointer-events: none; z-index: -1; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.96' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.3'/%3E%3C/svg%3E"); mix-blend-mode: soft-light; }
.hero-orb { position: absolute; pointer-events: none; border-radius: 50%; filter: blur(1px); z-index: -1; }
.hero-orb--one { width: 460px; height: 460px; right: 3%; top: 22%; background: radial-gradient(circle at 40% 40%, rgba(183,122,72,.14), rgba(183,122,72,.015) 58%, transparent 70%); }
.hero-orb--two { width: 280px; height: 280px; right: 28%; bottom: -7%; background: radial-gradient(circle, rgba(73,104,85,.11), transparent 69%); }
.hero-grid-line { position: absolute; pointer-events: none; background: rgba(243,235,220,.07); }
.hero-grid-line--v { top: 82px; bottom: 0; left: 59%; width: 1px; }
.hero-grid-line--h { left: 0; right: 0; bottom: 17%; height: 1px; opacity: .52; }
.hero-copy { z-index: 2; position: relative; width: 57%; max-width: 790px; margin-top: 16px; }
.eyebrow { display: flex; align-items: center; gap: 12px; color: #b7b3aa; font: 10px var(--mono); letter-spacing: .1em; }
.hero-eyebrow { margin-bottom: clamp(32px, 5vh, 54px); }
.eyebrow__rule { width: 27px; height: 1px; background: var(--orange); }
.eyebrow__year { color: #777a72; margin-left: 10px; }
.hero-title { font: 600 clamp(70px, 8.7vw, 140px)/.91 var(--sans); letter-spacing: -.085em; margin: 0; display: flex; flex-direction: column; align-items: flex-start; text-transform: uppercase; }
.hero-title__line { overflow: hidden; padding: 0 .12em .1em 0; display: block; }
.hero-title__line > span { display: block; }
.hero-title__line--serif { color: var(--orange); font: italic 500 clamp(78px, 9vw, 146px)/.93 var(--serif); letter-spacing: -.085em; text-transform: none; margin-left: clamp(0px, 4vw, 72px); }
.hero-title__period { color: var(--paper-white); }
.hero-description { max-width: 380px; color: #aaa99f; font-size: 14px; line-height: 1.8; margin: 31px 0 30px; }
.hero-actions { display: flex; align-items: center; gap: 25px; }
.button { display: inline-flex; align-items: center; justify-content: center; gap: 25px; padding: 15px 18px 15px 20px; font-size: 11px; font-weight: 600; transition: background .28s ease, color .28s ease, transform .28s ease, border-color .28s ease; }
.button svg { transition: transform .28s ease; }
.button:hover { transform: translateY(-2px); }
.button:hover svg { transform: translate(3px, -2px); }
.button--light { color: var(--ink); background: var(--paper-white); }
.button--light:hover { colo